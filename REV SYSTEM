        speedY = math.random(-40, 40) / 100,
        baseAlpha = p.BackgroundTransparency,
        offset = i
    }
end

RunService.Heartbeat:Connect(function()
    if not mainFrame.Visible then return end
    local t = tick()
    for _, data in ipairs(particles) do
        local f = data.frame
        local newX = f.Position.X.Scale + data.speedX * 0.002
        local newY = f.Position.Y.Scale + data.speedY * 0.002
        if newX > 1 or newX < 0 then data.speedX = -data.speedX end
        if newY > 1 or newY < 0 then data.speedY = -data.speedY end
        f.Position = UDim2.new(math.clamp(newX, 0, 1), 0, math.clamp(newY, 0, 1), 0)
        f.BackgroundTransparency = math.clamp(data.baseAlpha + ((math.sin(t * 3 + data.offset) + 1) / 2) * 0.2, 0, 1)
    end
end)

