particleContainer.Parent = mainFrame

local particles = {}
for i = 1, 25 do
    local p = Instance.new("Frame")
    p.Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5))
    p.Position = UDim2.new(math.random(), 0, math.random(), 0)
    p.BackgroundColor3 = Color3.fromRGB(255, math.random(50, 150), math.random(50, 150))
    p.BackgroundTransparency = math.random(40, 80) / 100
    p.BorderSizePixel = 0
    p.Parent = particleContainer
    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
    particles[i] = {
        frame = p,
        speedX = math.random(-40, 40) / 100,
        speedY = math.random(-40, 40) / 100,
        baseAlpha = p.BackgroundTransparency,
        offset = i
    }
end

RunService.Heartbeat:Connect(function()
    if not mainFrame.Visible then return end
    local t = tick()
    for _, data in ipairs(particles) do
        local f = data.frame
        local newX = f.Position.X.Scale + data.speedX * 0.002
        local newY = f.Position.Y.Scale + data.speedY * 0.002
        if newX > 1 or newX < 0 then data.speedX = -data.speedX end
        if newY > 1 or newY < 0 then data.speedY = -data.speedY end
        f.Position = UDim2.new(math.clamp(newX, 0, 1), 0, math.clamp(newY, 0, 1), 0)
        f.BackgroundTransparency = math.clamp(data.baseAlpha + ((math.sin(t * 3 + data.offset) + 1) / 2) * 0.2, 0, 1)
    end
end)

-- ========== SISTEMA DE RASTRO (AFTERIMAGE) ==========
local TRAIL_INTERVAL = 0.016
local lastTrailTime = 0

-- Spawna uma afterimage exatamente na posição atual do menu, que some com fade
local function spawnAfterimage(pos, size)
    local ghost = Instance.new("Frame")
    ghost.Size = size
    ghost.Position = pos
    ghost.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ghost.BackgroundTransparency = 0.45
    ghost.BorderSizePixel = 0
    ghost.ZIndex = mainFrame.ZIndex - 1
    ghost.ClipsDescendants = false
    ghost.Parent = gui
    Instance.new("UICorner", ghost).CornerRadius = UDim.new(0, 16)

    -- Borda vermelha igual ao menu real
    local ghostStroke = Instance.new("UIStroke")
    ghostStroke.Color = Color3.fromRGB(255, 0, 0)
    ghostStroke.Thickness = 2
    ghostStroke.Transparency = 0.2
    ghostStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    ghostStroke.Parent = ghost

    -- Gradiente igual ao menu real
    local ghostGrad = Instance.new("UIGradient")
    ghostGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(200, 0, 0)),
        ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(255, 50, 50)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(150, 0, 0)),
        ColorSequenceKeypoint.new(1,    Color3.fromRGB(255, 0, 0)),
    })
    ghostGrad.Rotation = 45
    ghostGrad.Parent = ghost

    -- Fade out: frame some, borda some junto
    local info = TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(ghost,       info, { BackgroundTransparency = 1 }):Play()
    local t2 = TweenService:Create(ghostStroke, info, { Transparency = 1 })
    t2:Play()
    t2.Completed:Connect(function() ghost:Destroy() end)
end

