-- ========== ÚNICO InputChanged GLOBAL ==========
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    -- Arrastar o menu principal
    if dragging then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartPos
        local newPos = UDim2.new(
            frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
        )

        -- Emite afterimage ANTES de mover: fica exatamente atrás
        local now = tick()
        if now - lastTrailTime >= TRAIL_INTERVAL then
            lastTrailTime = now
            spawnAfterimage(mainFrame.Position, mainFrame.Size)
        end

        mainFrame.Position = newPos
    end

    -- Arrastar o botão flutuante
    if floatingDragging then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - floatingDragStart
        if delta.Magnitude > 4 then floatingMoved = true end
        floatingButton.Position = UDim2.new(
            floatingStartPos.X.Scale, floatingStartPos.X.Offset + delta.X,
            floatingStartPos.Y.Scale, floatingStartPos.Y.Offset + delta.Y
        )
    end
end)

