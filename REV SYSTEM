-- ========== ESP (Drawing API) ==========
local espData = {}

local function clearESPForPlayer(target)
    local data = espData[target]
    if not data then return end
    for _, obj in pairs(data) do
        pcall(function() obj:Destroy() end)
    end
    espData[target] = nil
end

local function getOrCreate(target, key, drawType)
    if not espData[target] then espData[target] = {} end
    if not espData[target][key] then
        espData[target][key] = Drawing.new(drawType)
    end
    return espData[target][key]
end

local function updateESP()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local screenSize = camera.ViewportSize
    local centerScreen = Vector2.new(screenSize.X / 2, screenSize.Y)
    local myChar = player.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local activePlayers = {}

    for _, target in ipairs(Players:GetPlayers()) do
        if target == player then continue end
        activePlayers[target] = true

        local char = target.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local headPart = char and char:FindFirstChild("Head")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if not rootPart or not humanoid or humanoid.Health <= 0 then
            local data = espData[target]
            if data then
                for _, obj in pairs(data) do pcall(function() obj.Visible = false end) end
            end
            continue
        end

        local rootPos = rootPart.Position
        local headPos = headPart and headPart.Position or rootPos + Vector3.new(0, 2.5, 0)
        local rootScreen, rootOnScreen = camera:WorldToViewportPoint(rootPos)
        local headScreen, headOnScreen = camera:WorldToViewportPoint(headPos)

        if not (rootOnScreen and headOnScreen) then
            local data = espData[target]
            if data then
                for _, obj in pairs(data) do pcall(function() obj.Visible = false end) end
            end
            continue
        end

        local rootVec = Vector2.new(rootScreen.X, rootScreen.Y)
        local headVec = Vector2.new(headScreen.X, headScreen.Y)
        local height = math.abs(headVec.Y - rootVec.Y) * 1.5
        local width = height / 2

        local box = getOrCreate(target, "box", "Square")
        box.Thickness = 2
        box.Color = Color3.fromRGB(255, 0, 0)
        box.Filled = false
        box.Position = Vector2.new(rootVec.X - width / 2, rootVec.Y - height)
        box.Size = Vector2.new(width, height)
        box.Visible = true

        local line = getOrCreate(target, "line", "Line")
        line.Thickness = 1.5
        line.Color = Color3.fromRGB(255, 0, 0)
        line.Transparency = 0.5
        line.From = centerScreen
        line.To = Vector2.new(rootVec.X, rootVec.Y - height / 2)
        line.Visible = true

        local nameDraw = getOrCreate(target, "name", "Text")
        nameDraw.Size = 14
        nameDraw.Center = true
        nameDraw.Outline = true
        nameDraw.OutlineColor = Color3.fromRGB(0, 0, 0)
        nameDraw.Color = Color3.fromRGB(255, 0, 0)
        nameDraw.Font = Drawing.Fonts.UI
        nameDraw.Position = Vector2.new(rootVec.X, rootVec.Y - height - 16)
        nameDraw.Text = target.Name
        nameDraw.Visible = true

        local distDraw = getOrCreate(target, "dist", "Text")
        distDraw.Size = 11
        distDraw.Center = true
        distDraw.Outline = true
        distDraw.OutlineColor = Color3.fromRGB(0, 0, 0)
        distDraw.Color = Color3.fromRGB(255, 100, 100)
        distDraw.Font = Drawing.Fonts.UI
        distDraw.Position = Vector2.new(rootVec.X, rootVec.Y - height + 15)
        distDraw.Text = myHRP and (math.floor((rootPos - myHRP.Position).Magnitude) .. " st") or "? st"
        distDraw.Visible = true

        local healthPercent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        local healthDraw = getOrCreate(target, "health", "Line")
        healthDraw.Thickness = 4
        healthDraw.Color = healthPercent >= 0.6 and Color3.fromRGB(0, 255, 0)
            or healthPercent >= 0.3 and Color3.fromRGB(255, 255, 0)
            or Color3.fromRGB(255, 0, 0)
        healthDraw.From = Vector2.new(rootVec.X - width / 2 - 6, rootVec.Y - height)
        healthDraw.To = Vector2.new(rootVec.X - width / 2 - 6, rootVec.Y - height + (height * healthPercent))
        healthDraw.Visible = true
    end

    for target in pairs(espData) do
        if not activePlayers[target] then
            clearESPForPlayer(target)
        end
    end
end

local espConnection = nil

local function startESP()
    if espConnection then return end
    espConnection = RunService.RenderStepped:Connect(updateESP)
end

local function stopESP()
    if espConnection then espConnection:Disconnect(); espConnection = nil end
    for target in pairs(espData) do clearESPForPlayer(target) end
end

-- ========== FLY ==========
local bodyVelocity, bodyGyro, flyLoop

local function startFly()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    humanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = hrp

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
    bodyGyro.CFrame = hrp.CFrame
    bodyGyro.Parent = hrp

    flyLoop = RunService.Heartbeat:Connect(function()
        if not flying then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h or not bodyVelocity or not bodyGyro then return end

        local cam = workspace.CurrentCamera
        local dir = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

        bodyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.zero
        bodyGyro.CFrame = cam.CFrame
    end)
end

local function stopFly()
    if flyLoop then flyLoop:Disconnect(); flyLoop = nil end
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    local char = player.Character
    if char then
        local h = char:FindFirstChild("Humanoid")
        if h then h.PlatformStand = false end
    end
end

-- ========== NOCLIP ==========
local noclipConnection

local function startNoclip()
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    noclipConnection = RunService.Stepped:Connect(function()
        local char = player.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
end

local function stopNoclip()
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    local char = player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

